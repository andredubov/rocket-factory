# -----------------------------------------
# ОБЩИЙ ФАЙЛ КОНФИГУРАЦИИ МИКРОСЕРВИСНОЙ АРХИТЕКТУРЫ
# -----------------------------------------
# Этот файл содержит все переменные окружения для всех сервисов
# с префиксами для избежания конфликтов имен.
# -----------------------------------------

# -----------------------------------------
# CORE НАСТРОЙКИ (ОБЩИЕ КОМПОНЕНТЫ)
# -----------------------------------------

# Kafka настройки
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090
CORE_KAFKA_ORDER_PAID_TOPIC_NAME=order.paid
CORE_KAFKA_ORDER_ASSEMBLED_TOPIC_NAME=order.assembled


# -----------------------------------------
# INVENTORY СЕРВИС
# -----------------------------------------

# gRPC настройки
INVENTORY_GRPC_HOST=0.0.0.0
INVENTORY_GRPC_PORT=50051

# Логгер
INVENTORY_LOGGER_LEVEL=info
INVENTORY_LOGGER_AS_JSON=true

# MongoDB
INVENTORY_MONGO_IMAGE_NAME=mongo:7.0.5
INVENTORY_EXTERNAL_MONGO_PORT=27017
INVENTORY_INTERNAL_MONGO_PORT=27017

INVENTORY_MONGO_HOST=inventory-mongo

INVENTORY_MONGO_INITDB_DATABASE=inventory
INVENTORY_MONGO_INITDB_ROOT_USERNAME=inventory_admin
INVENTORY_MONGO_INITDB_ROOT_PASSWORD=inventory_secret
INVENTORY_MONGO_AUTH_SOURCE=admin


# -----------------------------------------
# PAYMENT СЕРВИС
# -----------------------------------------

# gRPC настройки
PAYMENT_GRPC_HOST=0.0.0.0
PAYMENT_GRPC_PORT=50052

# Логгер
PAYMENT_LOGGER_LEVEL=info
PAYMENT_LOGGER_AS_JSON=true


# -----------------------------------------
# ORDER СЕРВИС
# -----------------------------------------

# HTTP настройки
ORDER_HTTP_HOST=0.0.0.0
ORDER_HTTP_PORT=8080
ORDER_HTTP_READ_HEADER_TIMEOUT_SEC=5

# Логгер
ORDER_LOGGER_LEVEL=info
ORDER_LOGGER_AS_JSON=true

# PostgresDB
ORDER_PG_IMAGE_NAME=postgres:17.0-alpine3.20
ORDER_INTERNAL_PG_PORT=5432
ORDER_EXTERNAL_PG_PORT=50031

ORDER_PG_HOST=order-postgres

ORDER_PG_DB=order-service-database
ORDER_PG_USER=order-service-username
ORDER_PG_PASSWORD=order-service-password
ORDER_PG_SSL_MODE=disable
ORDER_MIGRATION_DIR=migrations

# Inventory service client
ORDER_INVENTORY_GRPC_HOST=inventory-service
ORDER_INVENTORY_GRPC_PORT=50051

# Payment service client
ORDER_PAYMENT_GRPC_HOST=payment-service
ORDER_PAYMENT_GRPC_PORT=50052

# Kafka настройки
ORDER_KAFKA_BROKERS=kafka:9092
ORDER_ORDER_ASSEMBLED_CONSUMER_GROUP_ID=1


# -----------------------------------------
# ORDER СЕРВИС
# -----------------------------------------

# Kafka настройки
ASSEMBLY_KAFKA_BROKERS=kafka:9092
ASSEMBLY_ORDER_PAID_CONSUMER_GROUP_ID=2
