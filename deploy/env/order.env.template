# ----------------------------
# Настройки HTTP-сервера
# ----------------------------

# Адрес, на котором будет слушать HTTP-сервер
HTTP_HOST=${ORDER_HTTP_HOST}

# Порт, на котором будет работать HTTP-сервер
HTTP_PORT=${ORDER_HTTP_PORT}

# Таймаут
HTTP_READ_HEADER_TIMEOUT_SEC=${ORDER_HTTP_READ_HEADER_TIMEOUT_SEC}


# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${ORDER_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${ORDER_LOGGER_AS_JSON}


# ----------------------------
# Настройки PostgresDB
# ----------------------------

# Название Docker-образа MongoDB (для docker-compose)
PG_IMAGE_NAME=${ORDER_PG_IMAGE_NAME}

# Внешний порт PostgresDB (для подключения извне контейнера)
EXTERNAL_PG_PORT=${ORDER_EXTERNAL_PG_PORT}

# Внутренний порт PostgresDB (для подключения извне контейнера)
INTERNAL_PG_PORT=${ORDER_INTERNAL_PG_PORT}

# Хост PostgresDB (внутри docker-сети)
PG_HOST=${ORDER_PG_HOST}

# Порт PostgresDB (внутри docker-сети)
PG_PORT=${ORDER_INTERNAL_PG_PORT}

# Название базы данных по умолчанию
PG_DB=${ORDER_PG_DB}

# Имя пользователя PostgresDB
PG_USER=${ORDER_PG_USER}

# Пароль пользователя PostgresDB
PG_PASSWORD=${ORDER_PG_PASSWORD}

# Режим SSL
PG_SSL_MODE=${ORDER_PG_SSL_MODE}

# Директория с миграциями для PostgresDB
MIGRATION_DIR=${ORDER_MIGRATION_DIR}


# ----------------------------
# Настройки gRPC-клиент Inventory-сервиса
# ----------------------------

# Хост Inventory-сервиса (внутри docker-сети)
INVENTORY_GRPC_HOST=${ORDER_INVENTORY_GRPC_HOST}

# Порт Inventory-сервиса (внутри docker-сети)
INVENTORY_GRPC_PORT=${ORDER_INVENTORY_GRPC_PORT}


# ----------------------------
# Настройки gRPC-клиент Payment-сервиса
# ----------------------------

# Хост Payment-сервиса (внутри docker-сети)
PAYMENT_GRPC_HOST=${ORDER_PAYMENT_GRPC_HOST}

# Порт Payment-сервиса (внутри docker-сети)
PAYMENT_GRPC_PORT=${ORDER_PAYMENT_GRPC_PORT}
