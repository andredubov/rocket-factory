# ----------------------------
# Настройки GRPC-сервера
# ----------------------------

# Адрес, на котором будет слушать GRPC-сервер
GRPC_HOST=${IAM_GRPC_HOST}

# Порт, на котором будет работать GRPC-сервер
GRPC_PORT=${IAM_GRPC_PORT}


# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${IAM_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${IAM_LOGGER_AS_JSON}

# Включить экспорт логов в OTLP (true/false)
LOGGER_ENABLE_OTLP=${IAM_LOGGER_ENABLE_OTLP}

# OTLP endpoint (например: otel-collector:4317)
LOGGER_OTLP_ENDPOINT=${IAM_LOGGER_OTLP_ENDPOINT}

# Имя сервиса (для трассировки/логирования)
LOGGER_SERVICE_NAME=${IAM_LOGGER_SERVICE_NAME}

# Окружение сервиса (например: dev, stage, prod)
LOGGER_SERVICE_ENVIRONMENT=${IAM_LOGGER_SERVICE_ENVIRONMENT}


# ----------------------------
# Настройки метрик
# ----------------------------

# OpenTelemetry collector endpoint (например: otel-collector:4317)
METRICS_OTEL_COLLECTOR_ENDPOINT=${IAM_METRICS_OTEL_COLLECTOR_ENDPOINT}

# Интервал отправки метрик OpenTelemetry коллектором
METRICS_OTEL_COLLECTOR_INTERVAL=${IAM_METRICS_OTEL_COLLECTOR_INTERVAL}

# Таймаут для отправки батча метрик OpenTelemetry коллектором
METRICS_OTEL_COLLECTOR_TIMEOUT=${IAM_METRICS_OTEL_COLLECTOR_TIMEOUT}


# ----------------------------
# Настройки трейсов
# ----------------------------

# OTel collector endpoint (например: otel-collector:4317)
TRACING_OTEL_COLLECTOR_ENDPOINT=${IAM_TRACING_OTEL_COLLECTOR_ENDPOINT}

# Имя сервиса (для трассировки/логирования)
TRACING_SERVICE_NAME=${IAM_TRACING_SERVICE_NAME}

# Окружение сервиса (например: dev, stage, prod)
TRACING_SERVICE_ENVIRONMENT=${IAM_TRACING_SERVICE_ENVIRONMENT}

# Версия сервиса
TRACING_SERVICE_VERSION=${IAM_TRACING_SERVICE_VERSION}


# ----------------------------
# Настройки PostgresDB
# ----------------------------

# Название Docker-образа MongoDB (для docker-compose)
PG_IMAGE_NAME=${IAM_PG_IMAGE_NAME}

# Внешний порт PostgresDB (для подключения извне контейнера)
EXTERNAL_PG_PORT=${IAM_EXTERNAL_PG_PORT}

# Внутренний порт PostgresDB (для подключения извне контейнера)
INTERNAL_PG_PORT=${IAM_INTERNAL_PG_PORT}

# Хост PostgresDB (внутри docker-сети)
PG_HOST=${IAM_PG_HOST}

# Порт PostgresDB (внутри docker-сети)
PG_PORT=${IAM_INTERNAL_PG_PORT}

# Название базы данных по умолчанию
PG_DB=${IAM_PG_DB}

# Имя пользователя PostgresDB
PG_USER=${IAM_PG_USER}

# Пароль пользователя PostgresDB
PG_PASSWORD=${IAM_PG_PASSWORD}

# Режим SSL
PG_SSL_MODE=${IAM_PG_SSL_MODE}

# Директория с миграциями для PostgresDB
MIGRATION_DIR=${IAM_MIGRATION_DIR}


# ----------------------------
# Настройки Redis
# ----------------------------

# Хост Redis (внутри docker-сети)
REDIS_HOST=${IAM_REDIS_HOST}

# Порт Redis (внутри docker-сети)
REDIS_PORT=${IAM_INTERNAL_REDIS_PORT}

# Внешний порт Redis (для подключения извне контейнера)
EXTERNAL_REDIS_PORT=${IAM_EXTERNAL_REDIS_PORT}

# Внутренний порт Redis (для подключения извне контейнера)
INTERNAL_REDIS_PORT=${IAM_INTERNAL_REDIS_PORT}

# Таймаут соединения с Redis
REDIS_CONNECTION_TIMEOUT=${IAM_REDIS_CONNECTION_TIMEOUT}

# Максимальное количество idle-соединений в пуле
REDIS_MAX_IDLE=${IAM_REDIS_MAX_IDLE}

# Время в секундах, после которого idle-соединение закрывается
REDIS_IDLE_TIMEOUT=${IAM_REDIS_IDLE_TIMEOUT}

# Перид времени жизни сессии в Redis
SESSION_TTL=${IAM_SESSION_TTL}