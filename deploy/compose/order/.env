# ----------------------------
# Настройки HTTP-сервера
# ----------------------------

# Адрес, на котором будет слушать HTTP-сервер
HTTP_HOST=0.0.0.0

# Порт, на котором будет работать HTTP-сервер
HTTP_PORT=8080

# Таймаут
HTTP_READ_HEADER_TIMEOUT_SEC=5


# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true

# Включить экспорт логов в OTLP (true/false)
LOGGER_ENABLE_OTLP=true

# OTLP endpoint (например: otel-collector:4317)
LOGGER_OTLP_ENDPOINT=otel-collector:4317

# Имя сервиса (для трассировки/логирования)
LOGGER_SERVICE_NAME=Order

# Окружение сервиса (например: dev, stage, prod)
LOGGER_SERVICE_ENVIRONMENT=dev


# ----------------------------
# Настройки метрик
# ----------------------------

# OpenTelemetry collector endpoint (например: otel-collector:4317)
METRICS_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317

# Интервал отправки метрик OpenTelemetry коллектором
METRICS_OTEL_COLLECTOR_INTERVAL=30s

# Таймаут для отправки батча метрик OpenTelemetry коллектором
METRICS_OTEL_COLLECTOR_TIMEOUT=10s


# ----------------------------
# Настройки трейсов
# ----------------------------

# OTel collector endpoint (например: otel-collector:4317)
TRACING_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317

# Имя сервиса (для трассировки/логирования)
TRACING_SERVICE_NAME=Order

# Окружение сервиса (например: dev, stage, prod)
TRACING_SERVICE_ENVIRONMENT=dev

# Версия сервиса
TRACING_SERVICE_VERSION=1.0.0


# ----------------------------
# Настройки PostgresDB
# ----------------------------

# Название Docker-образа MongoDB (для docker-compose)
PG_IMAGE_NAME=postgres:17.0-alpine3.20

# Внешний порт PostgresDB (для подключения извне контейнера)
EXTERNAL_PG_PORT=50031

# Внутренний порт PostgresDB (для подключения извне контейнера)
INTERNAL_PG_PORT=5432

# Хост PostgresDB (внутри docker-сети)
PG_HOST=order-postgres

# Порт PostgresDB (внутри docker-сети)
PG_PORT=5432

# Название базы данных по умолчанию
PG_DB=order-service-database

# Имя пользователя PostgresDB
PG_USER=order-service-username

# Пароль пользователя PostgresDB
PG_PASSWORD=order-service-password

# Режим SSL
PG_SSL_MODE=disable

# Директория с миграциями для PostgresDB
MIGRATION_DIR=migrations


# ----------------------------
# Настройки gRPC-клиент Inventory-сервиса
# ----------------------------

# Хост Inventory-сервиса (внутри docker-сети)
INVENTORY_GRPC_HOST=inventory-service

# Порт Inventory-сервиса (внутри docker-сети)
INVENTORY_GRPC_PORT=50051


# ----------------------------
# Настройки gRPC-клиент Payment-сервиса
# ----------------------------

# Хост Payment-сервиса (внутри docker-сети)
PAYMENT_GRPC_HOST=payment-service

# Порт Payment-сервиса (внутри docker-сети)
PAYMENT_GRPC_PORT=50052


# ----------------------------
# Настройки IAM-клиента
# ----------------------------

# Хост, IAM сервиса
IAM_GRPC_HOST=iam-service

# Порт, IAM сервиса
IAM_GRPC_PORT=50053


# ----------------------------
# Kafka настройки
# ----------------------------

# Адреса Kafka-брокеров через запятую
KAFKA_BROKERS=kafka:9092

# Название топика с событиями "Заказ оплачен"
ORDER_PAID_TOPIC_NAME=order.paid

# Название топика с событиями "Заказ собран"
ORDER_ASSEMBLED_TOPIC_NAME=order.assembled

# Идентификатор consumer group для обработки событий "Заказ собран"
ORDER_ASSEMBLED_CONSUMER_GROUP_ID=1