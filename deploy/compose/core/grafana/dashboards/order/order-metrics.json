{
    "id": null,
    "title": "Order Service Metrics",
    "tags": [
        "order-service",
        "business",
        "metrics"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "id": 1,
            "title": "Orders Created Rate",
            "type": "graph",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(otel_orders_total[5m])",
                    "legendFormat": "Orders created",
                    "refId": "A"
                }
            ],
            "xaxis": {
                "show": true
            },
            "yaxes": [
                {
                    "format": "short",
                    "label": "orders/sec",
                    "min": "0"
                },
                {
                    "format": "short",
                    "min": "0"
                }
            ],
            "lines": true,
            "fill": 1,
            "linewidth": 2,
            "pointradius": 2,
            "alert": {
                "conditions": [
                    {
                        "evaluator": {
                            "params": [
                                0
                            ],
                            "type": "lt"
                        },
                        "operator": {
                            "type": "and"
                        },
                        "query": {
                            "params": [
                                "A",
                                "5m",
                                "now"
                            ]
                        },
                        "reducer": {
                            "params": [],
                            "type": "avg"
                        },
                        "type": "query"
                    }
                ],
                "executionErrorState": "alerting",
                "frequency": "1m",
                "handler": 1,
                "message": "No orders created in last 5 minutes",
                "name": "No Orders Alert",
                "noDataState": "alerting"
            }
        },
        {
            "id": 2,
            "title": "Total Orders Created",
            "type": "stat",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "otel_orders_total",
                    "format": "time_series",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "displayMode": "list"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    }
                }
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            }
        },
        {
            "id": 3,
            "title": "Revenue by Currency",
            "type": "bargauge",
            "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "otel_orders_revenue_currency_total",
                    "format": "time_series",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "displayMode": "gradient",
                        "fieldColorMode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1000
                            },
                            {
                                "color": "red",
                                "value": 5000
                            }
                        ]
                    },
                    "unit": "currencyRUB"
                }
            },
            "options": {
                "displayMode": "gradient",
                "minVizHeight": 10,
                "minVizWidth": 0,
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showUnfilled": true
            }
        },
        {
            "id": 4,
            "title": "Total Revenue Over Time",
            "type": "graph",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "otel_orders_revenue_currency_total",
                    "legendFormat": "{{currency}}",
                    "refId": "A"
                }
            ],
            "xaxis": {
                "show": true
            },
            "yaxes": [
                {
                    "format": "currencyRUB",
                    "label": "Revenue",
                    "min": "0"
                },
                {
                    "format": "short",
                    "min": "0"
                }
            ],
            "lines": true,
            "fill": 1,
            "linewidth": 2,
            "stack": true,
            "percentage": false
        },
        {
            "id": 5,
            "title": "Revenue Breakdown",
            "type": "piechart",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "otel_orders_revenue_currency_total",
                    "format": "time_series",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "displayMode": "gradient",
                        "fieldColorMode": "thresholds"
                    },
                    "mappings": [],
                    "unit": "currencyRUB"
                }
            },
            "options": {
                "pieType": "pie",
                "displayLabels": [
                    "name",
                    "value",
                    "percentage"
                ],
                "legend": {
                    "displayMode": "list",
                    "placement": "right",
                    "values": [
                        "value"
                    ]
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "asc"
                }
            }
        }
    ],
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "30s",
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "2h",
            "1d"
        ],
        "time_options": [
            "5m",
            "15m",
            "1h",
            "6h",
            "12h",
            "24h",
            "2d",
            "7d",
            "30d"
        ]
    },
    "templating": {
        "list": [
            {
                "name": "currency",
                "type": "query",
                "datasource": "Prometheus",
                "query": "label_values(otel_orders_revenue_currency_total, currency)",
                "refresh": 1,
                "includeAll": true,
                "multi": true,
                "allValue": ".*"
            },
            {
                "name": "time_range",
                "type": "interval",
                "query": "1m,5m,15m,30m,1h,2h,6h,12h,1d",
                "refresh": 2,
                "includeAll": false,
                "current": {
                    "text": "1h",
                    "value": "1h"
                }
            }
        ]
    },
    "refresh": "30s",
    "schemaVersion": 38,
    "style": "dark",
    "version": 1,
    "uid": "order-service-metrics"
}