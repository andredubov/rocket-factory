{
    "id": null,
    "title": "Assembly Service Metrics",
    "tags": [
        "assembly-service",
        "performance",
        "metrics"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "panels": [
        {
            "id": 1,
            "title": "Assembly Duration Distribution",
            "type": "heatmap",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(otel_assembly_duration_seconds_bucket[5m])) by (le)",
                    "format": "heatmap",
                    "legendFormat": "{{le}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "scheme",
                        "scheme": "oranges"
                    }
                }
            },
            "options": {
                "calculate": false,
                "dataFormat": "tsbuckets",
                "yAxis": {
                    "decimals": 0,
                    "format": "s",
                    "logBase": 1,
                    "max": 30,
                    "min": 0
                },
                "showYAxis": true,
                "reverseYBuckets": false
            }
        },
        {
            "id": 2,
            "title": "Average Assembly Time",
            "type": "stat",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "rate(otel_assembly_duration_seconds_sum[5m]) / rate(otel_assembly_duration_seconds_count[5m])",
                    "format": "time_series",
                    "legendFormat": "Avg time",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 2,
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 8
                            },
                            {
                                "color": "red",
                                "value": 12
                            }
                        ]
                    },
                    "unit": "s"
                }
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "mean"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            }
        },
        {
            "id": 3,
            "title": "Assembly Rate (orders/min)",
            "type": "stat",
            "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "rate(otel_assembly_duration_seconds_count[5m]) * 60",
                    "format": "time_series",
                    "legendFormat": "Orders/min",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "decimals": 1,
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 2
                            },
                            {
                                "color": "green",
                                "value": 4
                            }
                        ]
                    },
                    "unit": "none"
                }
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "mean"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            }
        },
        {
            "id": 4,
            "title": "Assembly Duration Percentiles",
            "type": "graph",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(otel_assembly_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.90, sum(rate(otel_assembly_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p90",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(otel_assembly_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p95",
                    "refId": "C"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(otel_assembly_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p99",
                    "refId": "D"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisLabel": "Time (seconds)",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "gradientMode": "none",
                        "hideFrom": {
                            "legend": false,
                            "tooltip": false,
                            "viz": false
                        },
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "auto",
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 15
                            }
                        ]
                    },
                    "unit": "s"
                }
            },
            "options": {
                "legend": {
                    "calcs": [],
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            }
        },
        {
            "id": 5,
            "title": "Assembly Time Distribution",
            "type": "bargauge",
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum(rate(otel_assembly_duration_seconds_bucket[5m])) by (le)",
                    "format": "time_series",
                    "instant": true,
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "displayMode": "gradient",
                        "fieldColorMode": "thresholds"
                    },
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 5
                            },
                            {
                                "color": "orange",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 15
                            }
                        ]
                    },
                    "unit": "short"
                }
            },
            "options": {
                "displayMode": "gradient",
                "minVizHeight": 10,
                "minVizWidth": 0,
                "orientation": "horizontal",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showUnfilled": true
            }
        }
    ],
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "timepicker": {
        "refresh_intervals": [
            "5s",
            "10s",
            "30s",
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "2h",
            "1d"
        ],
        "time_options": [
            "5m",
            "15m",
            "1h",
            "6h",
            "12h",
            "24h",
            "2d",
            "7d",
            "30d"
        ]
    },
    "templating": {
        "list": [
            {
                "name": "time_range",
                "type": "interval",
                "query": "1m,5m,15m,30m,1h,2h,6h,12h,1d",
                "refresh": 2,
                "includeAll": false,
                "current": {
                    "text": "1h",
                    "value": "1h"
                }
            },
            {
                "name": "percentile",
                "type": "query",
                "datasource": "Prometheus",
                "query": "label_values(histogram_quantile(0.95, otel_assembly_duration_seconds_bucket), le)",
                "refresh": 1,
                "includeAll": true,
                "multi": false,
                "allValue": ".*"
            }
        ]
    },
    "refresh": "10s",
    "schemaVersion": 38,
    "style": "dark",
    "version": 1,
    "uid": "assembly-service-metrics",
    "annotations": {
        "list": [
            {
                "name": "High Assembly Time",
                "datasource": "Prometheus",
                "enable": true,
                "expr": "histogram_quantile(0.95, otel_assembly_duration_seconds_bucket) > 12",
                "iconColor": "red",
                "target": {
                    "limit": 100,
                    "matchAny": false,
                    "tags": [],
                    "type": "tags"
                },
                "type": "tags"
            }
        ]
    }
}