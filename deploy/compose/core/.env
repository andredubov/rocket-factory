# ----------------------------
# Настройки Kafka
# ----------------------------

# Внешний порт Kafka, через который клиенты подключаются снаружи контейнера
KAFKA_EXTERNAL_PORT=9092

# Внутренний порт Kafka, который используется внутри docker-сети
KAFKA_INTERNAL_PORT=29092

# Порт контроллера Kafka (используется при работе в режиме KRaft)
KAFKA_CONTROLLER_PORT=29093

# Порт для веб-интерфейса Kafka UI (например, Kafdrop, Redpanda Console)
KAFKA_UI_PORT=8090

# Название топика с событиями "Заказ оплачен"
KAFKA_ORDER_PAID_TOPIC_NAME=order.paid

# Название топика с событиями "Заказ собран"
KAFKA_ORDER_ASSEMBLED_TOPIC_NAME=order.assembled

# Внешний порт Elasticsearch, через который клиенты подключаются снаружи контейнера
ELASTICSEARCH_EXTERNAL_PORT=9200

# Внутренний порт Elasticsearch, который используется внутри docker-сети
ELASTICSEARCH_INTERNAL_PORT=9200

# Внешний порт Kibana, через который клиенты подключаются снаружи контейнера
KIBANA_EXTERNAL_PORT=5601

# Внутренний порт Elasticsearch, который используется внутри docker-сети
KIBANA_INTERNAL_PORT=5601

# Внешний порт Prometheus, через который клиенты подключаются снаружи контейнера
PROMETHEUS_EXTERNAL_PORT=9090

# Внутренний порт Prometheus, который используется внутри docker-сети
PROMETHEUS_INTERNAL_PORT=9090

# Внешний порт Grafana, через который клиенты подключаются снаружи контейнера
GRAFANA_EXTERNAL_PORT=3000

# Внутренний порт Grafana, который используется внутри docker-сети
GRAFANA_INTERNAL_PORT=3000

# Имя пользователя для Grafana
GRAFANA_ADMIN_USER=admin

# Пароль пользователя Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Внешний порт Jaeger, через который клиенты подключаются снаружи контейнера
JAEGER_UI_EXTERNAL_PORT=16686

# Внутренний порт Jeager, который используется внутри docker-сети
JAEGER_UI_INTERNAL_PORT=16686

# Внешний gRPC порт Otel-collector, через который клиенты подключаются снаружи контейнера
OTEL_COLLECTOR_EXTERNAL_GRPC_PORT=4317

# Внутренний gRPC порт Otel-collector, который используется внутри docker-сети
OTEL_COLLECTOR_INTERNAL_GRPC_PORT=4317

# Внешний HTTP порт Otel-collector, через который клиенты подключаются снаружи контейнера
OTEL_COLLECTOR_EXTERNAL_HTTP_PORT=4318

# Внутренний HTTP порт Otel-collector, который используется внутри docker-сети
OTEL_COLLECTOR_INTERNAL_HTTP_PORT=4318

# Внешний порт встроенного HTTP-сервера OTel Collector'a, который будет предоставлять метрики о внутренней работе коллектора
OTEL_COLLECTOR_METRICS_EXTERNAL_PORT=8888

# Внутренний порт, который используется внутри docker-сети, встроенного HTTP-сервера OTel Collector'a, который будет предоставлять метрики о внутренней работе коллектора
OTEL_COLLECTOR_METRICS_INTERNAL_PORT=8888