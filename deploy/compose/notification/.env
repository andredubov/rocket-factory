# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true

# Включить экспорт логов в OTLP (true/false)
LOGGER_ENABLE_OTLP=true

# OTLP endpoint (например: otel-collector:4317)
LOGGER_OTLP_ENDPOINT=otel-collector:4317

# Имя сервиса (для трассировки/логирования)
LOGGER_SERVICE_NAME=Notification

# Окружение сервиса (например: dev, stage, prod)
LOGGER_SERVICE_ENVIRONMENT=dev


# ----------------------------
# Настройки метрик
# ----------------------------

# OpenTelemetry collector endpoint (например: otel-collector:4317)
METRICS_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317

# Интервал отправки метрик OpenTelemetry коллектором
METRICS_OTEL_COLLECTOR_INTERVAL=30s

# Таймаут для отправки батча метрик OpenTelemetry коллектором
METRICS_OTEL_COLLECTOR_TIMEOUT=10s


# ----------------------------
# Kafka настройки
# ----------------------------

# Адреса Kafka-брокеров через запятую
KAFKA_BROKERS=kafka:9092

# Название топика с событиями "Заказ оплачен"
ORDER_PAID_TOPIC_NAME=order.paid

# Название топика с событиями "Заказ собран"
ORDER_ASSEMBLED_TOPIC_NAME=order.assembled

# Идентификатор consumer group для обработки событий "Заказ оплачен"
ORDER_PAID_CONSUMER_GROUP_ID=3

# Идентификатор consumer group для обработки событий "Заказ собран"
ORDER_ASSEMBLED_CONSUMER_GROUP_ID=4

# Идентификатор Telegram бота
TELEGRAM_BOT_TOKEN=token

# Идентификатор чата в Telegram
TELEGRAM_CHAT_ID=123