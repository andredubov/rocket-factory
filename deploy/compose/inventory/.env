# ----------------------------
# Настройки gRPC-сервера
# ----------------------------

# Адрес, на котором будет слушать gRPC-сервер
GRPC_HOST=0.0.0.0

# Порт, на котором будет работать gRPC-сервер
GRPC_PORT=50051


# ----------------------------
# Настройки IAM-клиента
# ----------------------------

# Хост, IAM сервиса
IAM_GRPC_HOST=iam-service

# Порт, IAM сервиса
IAM_GRPC_PORT=50053


# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true


# ----------------------------
# Настройки MongoDB
# ----------------------------

# Название Docker-образа MongoDB (для docker-compose)
MONGO_IMAGE_NAME=mongo:7.0.5

# Внешний порт MongoDB (для подключения извне контейнера)
EXTERNAL_MONGO_PORT=27017

# Внутренний порт MongoDB (для подключения внутри docker-сети)
INTERNAL_MONGO_PORT=27017

# Хост MongoDB (внутри docker-сети)
MONGO_HOST=inventory-mongo

# Внутренний порт MongoDB
MONGO_PORT=27017

# Название базы данных по умолчанию
MONGO_INITDB_DATABASE=inventory

# База для аутентификации
MONGO_AUTH_SOURCE=admin

# Имя root-пользователя MongoDB
MONGO_INITDB_ROOT_USERNAME=inventory_admin

# Пароль root-пользователя MongoDB
MONGO_INITDB_ROOT_PASSWORD=inventory_secret
