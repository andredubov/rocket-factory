# Postgres
PG_HOST=order-postgres
PG_PORT=5432
PG_PORT_OUT=50031
PG_DB=order-service-database
PG_USER=order-service-username
PG_PASSWORD=order-service-password
PG_SSL_MODE=disable
MIGRATION_DIR=migrations
# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT_SEC=5
# Inventory service client
INVENTORY_GRPC_HOST=inventory-service
INVENTORY_GRPC_PORT=50051
# Payment service client
PAYMENT_GRPC_HOST=payment-service
PAYMENT_GRPC_PORT=50052